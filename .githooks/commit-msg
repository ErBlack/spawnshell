#!/bin/sh
set -eu

subject=$(grep -v '^#' "$1" | grep -m 1 . || true)
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'

if printf '%s\n' "$subject" | grep -qE "$pattern"; then
  exit 0
fi
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi
if [ -z "${CI:-}" ] && printf '%s\n' "$subject" | grep -qE '^(fixup|squash|amend)! '; then
  exit 0
fi

echo "commit message is not a conventional commit: $subject" >&2
echo "expected: <type>(<scope>)?: <description>, type is one of feat fix docs style refactor perf test build ci chore revert" >&2
exit 1
