#!/bin/sh
set -eu

files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

if printf '%s\n' "$files" | grep -qE '\.(ts|css|json)$'; then
  ./node_modules/.bin/biome check --write --staged --no-errors-on-unmatched
fi

if printf '%s\n' "$files" | grep -q '\.rs$'; then
  cargo fmt --manifest-path src-tauri/Cargo.toml --all
  cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --fix --allow-dirty --allow-staged -q
fi

git diff --cached --name-only --diff-filter=ACM -z | xargs -0 git add
