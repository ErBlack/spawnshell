{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spawnshell",
  "version": "0.0.0",
  "identifier": "com.erblack.spawnshell-terminal",
  "build": {
    "beforeDevCommand": "npm run frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "object-src 'none'; base-uri 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Spawnshell",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["Assets.car"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-"
    }
  }
}
