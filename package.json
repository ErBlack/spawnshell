{
  "name": "spawnshell-terminal",
  "private": true,
  "version": "0.0.2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "tauri dev",
    "build": "tauri build",
    "frontend": "vite",
    "frontend:build": "vite build",
    "site": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "lint": "biome check src site && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "fix": "biome check --write src site && cargo fmt --manifest-path src-tauri/Cargo.toml --all && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --fix --allow-dirty --allow-staged",
    "check:types": "tsc",
    "check:unused": "knip",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.6",
    "knip": "^6.27.0",
    "marked": "^18.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
